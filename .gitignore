# Raw inputs: third-party data, not redistributed. Only the instructions are
# versioned.
/data/*
!/data/README.md

# Derived data and raw simulation trajectories, both regenerated by the
# pipeline.
/outputs/
/data_simulations/

# Model runs: the scan inventories (n0_grid_results.csv, best_n0_run.json) are
# versioned, the multi-hundred-MB trajectory dumps they point to are not.
sim_runs/**/data_simulations/

# Belt and braces: no data file formats belong in this repository, wherever
# they are written.
*.pkl
*.parquet
*.dat

# Compiled model binaries.
model_micro_macro
modelling_micro_macro_branching
*.o

__pycache__/
.ipynb_checkpoints/
